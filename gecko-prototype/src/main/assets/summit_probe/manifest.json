{
  "manifest_version": 2,
  "name": "Summit Probe",
  "version": "1.5",
  "description": "Detects independent stacked fixed/sticky header layers, offsets them below the status bar and reports their colour to the app.",
  "browser_specific_settings": {
    "gecko": {
      "id": "summit-probe@example.com"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "probe.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}

{
  "manifest_version": 2,
  "name": "Summit Probe",
  "version": "1.7",
  "description": "Detects semantic navigation layers, strictly excludes YouTube player overlays/watch content, restores stale offsets after SPA navigation and reports diagnostics.",
  "browser_specific_settings": {
    "gecko": {
      "id": "summit-probe@example.com"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "probe.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}

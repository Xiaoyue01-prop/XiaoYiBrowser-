{
  "manifest_version": 2,
  "name": "Summit Probe",
  "version": "2.0",
  "description": "Detects pinned and normal-flow top headers, reports page colours, protects YouTube player overlays, applies safe YouTube ad cosmetics, and reports diagnostics.",
  "browser_specific_settings": {
    "gecko": {
      "id": "summit-probe@example.com"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "probe.js",
        "reserve.js",
        "youtube.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
